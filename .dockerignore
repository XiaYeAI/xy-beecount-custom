# Reproducible dependencies and build outputs are recreated by Dockerfile.
node_modules
frontend/node_modules
frontend/**/node_modules
frontend/apps/web/dist
**/__pycache__
**/*.py[cod]
.mypy_cache
.ruff_cache
**/*.tsbuildinfo
